  "cards": [
    {
      "dot": "violet",
      "title": "Nine note features, one list",
      "items": [
        "elaboration · enrichment · summarize · tidy · organize · deep-dive · title · REM · illustrate",
        "modules/registry.ts names every feature; each constructor takes ModuleDeps first"
      ]
    },
    {
      "dot": "emerald",
      "title": "Acyclic by injection",
      "items": [
        "pipeline/, intake/, checkpoints/, api/ never import a feature; shared/ and commands/ import none",
        "Only feature → feature runtime import: video → audio; the audio, video and image note scanners live in shared/"
      ]
    },
    {
      "dot": "amber",
      "title": "What leaves the vault",
      "items": [
        "AI calls go through one AIClient over requestUrl; yt-dlp/ffmpeg are desktop-only",
        "Illustrate sends an AI-proposed search query, never note text",
        "System 1 decisions (TypeSafe) are off by default; turned on, note text goes to Jev"
      ]
    },
    {
      "dot": "cyan",
      "title": "Agents drive the same code",
      "items": [
        "synapse-mcp runs each tool as one fixed obsidian eval expression; arguments travel as JSON, never as code",
        "Long verbs are jobs; with external billing the agent writes the text and it takes the normal checks and queue-held write"
      ]
    }
  ]
